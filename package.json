{
  "name": "radix-tour",
  "version": "1.0.1",
  "description": "Composable product tours built on Radix primitives, styled with Tailwind.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "workspaces": [
    ".",
    "test",
    "website"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "format": "biome format --write .",
    "check:fix": "biome check --write .",
    "test": "npm run build && playwright test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "tsc --noEmit && biome check . && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/primitive": "^1.1.7",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-context": "^1.2.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-primitive": "^2.1.10",
    "@radix-ui/react-use-callback-ref": "^1.1.4",
    "@radix-ui/react-use-layout-effect": "^1.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.2"
  },
  "author": "Wesley Júnior",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bw3sley/radix-tour.git"
  },
  "homepage": "https://tour.bw3sley.dev",
  "bugs": {
    "url": "https://github.com/bw3sley/radix-tour/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "tour",
    "product-tour",
    "onboarding",
    "walkthrough",
    "radix-ui",
    "tailwindcss",
    "headless",
    "unstyled",
    "accessibility"
  ]
}
